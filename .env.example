# Copy to .env and fill in yourself. NEVER commit real values.
# The app reads these from the process environment (use `source .env`-style loading or direnv).

# --- Webull OpenAPI (required for live trading and Webull market data) ---
# Apply at https://developer.webull.com -> API Management
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=

# --- Live trading hard gate ---
# Live orders are refused unless this exact value is set AND config mode="live" AND you pass --live.
# LIVE_TRADING_ACK=I_UNDERSTAND_THE_RISKS

# --- Claude trade reviewer (optional) ---
ANTHROPIC_API_KEY=

# --- Gmail IMAP for thinkorswim alert ingestion (optional) ---
# Use a Google App Password (Google Account -> Security -> 2-Step Verification -> App passwords)
GMAIL_IMAP_USER=patelaryan.co@gmail.com
GMAIL_IMAP_APP_PASSWORD=
